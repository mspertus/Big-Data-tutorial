<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd"
	 >
  <modelVersion>4.0.0</modelVersion>
  <groupId>edu.uchicago.mpcs53013</groupId>
  <artifactId>word-count-archetype</artifactId>
  <version>6.0.0</version>
  <packaging>maven-archetype</packaging>
  <name>Hadoop WordCount Archetype</name>
  <url>http://edu.uchicago.mpcs53013</url>
  <parent>
    <groupId>edu.uchicago.mpcs53013</groupId>
    <artifactId>parent</artifactId>
    <version>1.0.1</version>
  </parent>
  <developers>
    <developer>
      <name>Mike Spertus</name>
      <email>mike@spertus.com</email>
    </developer>
  </developers>
  <scm>
    <url>https://github.com/mspertus/Big-Data-tutorial</url>
  </scm>
  <licenses>
    <license>
      <name>Apache 2</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
      <comments>Use apache license because we are including Apache Hadoop example</comments>
    </license>
  </licenses>
  <description>Create the WordCount example from the Hadoop docs</description>
  <build>
    <sourceDirectory>src/main/java</sourceDirectory>
    <extensions>
      <extension>
        <groupId>org.apache.maven.archetype</groupId>
        <artifactId>archetype-packaging</artifactId>
        <version>3.0.1</version>
      </extension>
    </extensions>

    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-archetype-plugin</artifactId>
          <version>3.0.1</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
